---
// Inline SVG icons. Decorative by default (aria-hidden); pair with visible text or an aria-label on the parent.
interface Props {
  name: 'mail' | 'arrow-up-right' | 'copy' | 'sun' | 'moon' | 'github' | 'linkedin' | 'menu' | 'close';
  class?: string;
}
const { name, class: className = 'icon' } = Astro.props;
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.6, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---
{name === 'mail' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...stroke}><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6 8.5 7 8.5-7" /></svg>
)}
{name === 'arrow-up-right' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...stroke}><path d="M7 17 17 7M8.5 7H17v8.5" /></svg>
)}
{name === 'copy' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...stroke}><rect x="8" y="8" width="12" height="12" rx="1.5" /><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8" /></svg>
)}
{name === 'sun' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...stroke}><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
)}
{name === 'moon' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...stroke}><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
)}
{name === 'menu' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...stroke}><path d="M4 8h16M4 16h16" /></svg>
)}
{name === 'close' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...stroke}><path d="M6 6l12 12M18 6 6 18" /></svg>
)}
{name === 'github' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" /></svg>
)}
{name === 'linkedin' && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.03-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21H9V9Z" /></svg>
)}
